# WordReplace environment overrides
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
# docker-compose.yml / docker-compose.example.yml read .env automatically.

# Comma-separated list of allowed CORS origins.
CORS_ALLOW_ORIGINS=http://localhost:12344,http://localhost:3000

# Comma-separated list of allowed Host headers ("*" = no restriction).
ALLOWED_HOSTS=*

# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=50

# Maximum number of Excel data rows, cells, and replace rules.
MAX_EXCEL_ROWS=20000
MAX_EXCEL_CELLS=200000
MAX_REPLACE_RULES=500

# Maximum rows and characters returned in a preview.
MAX_PREVIEW_ROWS=25
MAX_PREVIEW_CHARS=20000

# Run cache lifetime / maximum entries / maximum total bytes.
RUN_CACHE_TTL_SECONDS=1800
RUN_CACHE_MAX_ENTRIES=200
RUN_CACHE_MAX_BYTES=536870912

# Number of replace runs allowed to execute concurrently.
MAX_CONCURRENT_RUNS=1

# Export token signing secret.
# WARNING: Change this to a long, random value before exposing the service.
# The default is insecure. Generate one with: openssl rand -hex 32
EXPORT_TOKEN_SECRET=change-this-secret

# SQLAlchemy database URL.
DATABASE_URL=sqlite:////app/data/wordreplace.db
